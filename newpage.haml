<html>
<body>

<!-- Headings -->
<h1>Welcome</h1>
<h2>HTML Text Formatting</h2>

<!-- Paragraph -->
<p>This is a paragraph in HTML.</p>

<!-- Block Quote -->
<blockquote>
This is a block quote example.
</blockquote>

<!-- Font Styles -->
<b>Bold Text</b><br>
<i>Italic Text</i><br>
<u>Underlined Text</u><br>

<!-- Character Entities -->
<p>
Less than symbol: &lt; <br>
Greater than symbol: &gt; <br>
Copyright symbol: &copy;
</p>

</body>
</html>